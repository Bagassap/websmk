<%- include('partials/head') %>
<section class="hero"><div class="wrap hero-grid">
  <div>
    <p class="eyebrow"><%= site.tagline %></p>
    <h1><%= site.hero_title %></h1>
    <p class="lead"><%= site.hero_text %></p>
    <div class="actions">
      <a class="btn btn-gold" href="<%= site.spmb_url %>" target="_blank" rel="noopener">Daftar Sekarang</a>
      <a class="btn btn-line" href="/tentang-kami">Profil Sekolah</a>
    </div>
  </div>
  <% if (lead) { %>
  <a class="hero-news" href="/berita/<%= lead.slug %>">
    <span class="hero-img"><% if (lead.image) { %><img src="/uploads/<%= lead.image %>" alt=""><% } %></span>
    <span class="hero-cap"><small>Berita terbaru · <%= fmtDate(lead.published_at) %></small><strong><%= lead.title %></strong></span>
  </a>
  <% } %>
</div></section>

<section class="stats"><div class="wrap stats-grid">
  <div><strong>1.500</strong><span>Peserta didik</span></div>
  <div><strong>2003</strong><span>Tahun berdiri</span></div>
  <div><strong>4</strong><span>Program keahlian</span></div>
  <div><strong><%= stats.staff %></strong><span>Guru dan staff</span></div>
</div></section>

<section class="section"><div class="wrap">
  <div class="section-head">
    <div><p class="eyebrow dark">Program Keahlian</p><h2>Pilih jurusan untuk masa depanmu</h2></div>
  </div>
  <div class="programs">
    <% programs.forEach((x) => { %>
    <a class="program" href="/<%= x.slug %>">
      <span class="program-img"><% if (x.image) { %><img src="<%= x.image %>" alt="" loading="lazy"><% } %><b><%= x.code %></b></span>
      <span class="program-body"><strong><%= x.name %></strong><span><%= x.text %></span></span>
    </a>
    <% }) %>
  </div>
</div></section>

<section class="section tint"><div class="wrap values">
  <div><p class="eyebrow dark">Sekolah Keren</p><h2>Pendidikan yang terjamin</h2><p><%= site.about_text %></p><a class="text-link" href="/sejarah-singkat">Baca sejarah sekolah</a></div>
  <ul>
    <li><strong>Kreatif</strong><span>Mengasah keterampilan dan gagasan melalui praktik.</span></li>
    <li><strong>Religius</strong><span>Menumbuhkan akhlakul karimah dalam kegiatan sehari-hari.</span></li>
    <li><strong>Nasionalis</strong><span>Menanamkan cinta tanah air dalam program sekolah.</span></li>
  </ul>
</div></section>

<section class="section"><div class="wrap">
  <div class="section-head">
    <div><p class="eyebrow dark">Info Terkini</p><h2>Cerita, kegiatan, dan prestasi</h2></div>
    <a class="text-link" href="/berita">Semua berita (<%= stats.posts %>)</a>
  </div>
  <div class="grid"><% posts.forEach((p) => { %><%- include('partials/card', { p }) %><% }) %></div>
</div></section>

<section class="cta"><div class="wrap cta-in">
  <div><h2>Siap bergabung bersama Sekolah Keren?</h2><p>Hubungi admin untuk informasi pendaftaran dan program keahlian.</p></div>
  <div class="actions">
    <a class="btn btn-gold" href="<%= site.spmb_url %>" target="_blank" rel="noopener">Daftar SPMB</a>
    <a class="btn btn-line" href="<%= waLink %>" target="_blank" rel="noopener">Chat WhatsApp</a>
  </div>
</div></section>
<%- include('partials/foot') %>
