<%- include('_head', { title: item.id ? `Edit ${label}` : `Tambah ${label}` }) %>
<div class="bar"><h1><%= item.id ? `Edit ${label}` : `Tambah ${label}` %></h1>
<% if (item.id && item.status === 'publish') { %><a class="btn soft" target="_blank" rel="noopener" href="<%= type === 'post' ? `/berita/${item.slug}` : `/${item.slug}` %>">Lihat</a><% } %></div>
<% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
<form method="post" action="/admin/<%= kind %>/<%= item.id || 'baru' %>" class="editor-form" id="content-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="panel">
    <label>Judul<input name="title" value="<%= item.title %>" required maxlength="300"></label>
    <label>Alamat (slug)<input name="slug" value="<%= item.slug %>" placeholder="otomatis dari judul"></label>
    <div class="field">
      <span class="label">Isi</span>
      <div class="toolbar" role="toolbar" aria-label="Format teks">
        <button type="button" data-cmd="bold"><b>B</b></button>
        <button type="button" data-cmd="italic"><i>I</i></button>
        <button type="button" data-block="h2">H2</button>
        <button type="button" data-block="h3">H3</button>
        <button type="button" data-block="p">Teks</button>
        <button type="button" data-cmd="insertUnorderedList">Daftar</button>
        <button type="button" data-cmd="insertOrderedList">Nomor</button>
        <button type="button" data-block="blockquote">Kutipan</button>
        <button type="button" data-action="link">Link</button>
        <button type="button" data-action="image">Gambar</button>
        <button type="button" data-action="source">HTML</button>
      </div>
      <div id="editor" class="editor prose" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Isi"></div>
      <textarea id="content_html" name="content_html" class="source" hidden aria-label="Kode HTML"><%= item.content_html %></textarea>
      <input type="file" id="inline-image" accept="image/jpeg,image/png,image/webp,image/gif" hidden>
    </div>
    <label>Ringkasan<textarea name="excerpt" rows="3"><%= item.excerpt %></textarea></label>
  </div>
  <div class="panel side-panel">
    <label>Status<select name="status">
      <% [['publish','Tayang'],['draft','Draf'],['trash','Sampah']].forEach(([v,l]) => { %><option value="<%= v %>" <%= item.status === v ? 'selected' : '' %>><%= l %></option><% }) %>
    </select></label>
    <label>Tanggal terbit<input type="datetime-local" name="published_at" value="<%= new Date(new Date(item.published_at || Date.now()).getTime() + 7 * 3600000).toISOString().slice(0, 16) %>" data-wib></label>
    <div class="field">
      <span class="label">Gambar utama</span>
      <input type="hidden" name="featured_media_id" id="featured_id" value="<%= item.featured_media_id || '' %>">
      <img id="featured_preview" class="preview" src="<%= item.image ? `/uploads/${item.image}` : '' %>" alt="" <%= item.image ? '' : 'hidden' %>>
      <input type="file" id="featured_file" accept="image/jpeg,image/png,image/webp,image/gif" aria-label="Unggah gambar utama">
    </div>
    <% if (type === 'post') { %>
    <fieldset><legend>Kategori</legend>
      <% categories.forEach((c) => { %><label class="check"><input type="checkbox" name="categories" value="<%= c.id %>" <%= selected.includes(c.id) ? 'checked' : '' %>> <%= c.name %></label><% }) %>
    </fieldset>
    <% } %>
    <label>Judul SEO<input name="seo_title" value="<%= item.seo_title %>"></label>
    <label>Deskripsi SEO<textarea name="seo_description" rows="3"><%= item.seo_description %></textarea></label>
    <button class="btn">Simpan</button>
  </div>
</form>
<%- include('_foot') %>
