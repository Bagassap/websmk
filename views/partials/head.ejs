<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= meta.title ? `${meta.title} | ${site.site_name}` : `${site.site_name} | ${site.tagline}` %></title>
<meta name="description" content="<%= meta.description %>">
<meta property="og:title" content="<%= meta.title || site.site_name %>">
<meta property="og:description" content="<%= meta.description %>">
<meta property="og:site_name" content="<%= site.site_name %>">
<% if (meta.image) { %><meta property="og:image" content="<%= meta.image %>"><% } %>
<link rel="alternate" type="application/rss+xml" title="Berita" href="/feed">
<link rel="stylesheet" href="/css/site.css">
<script src="/js/site.js" defer></script>
</head>
<body>
<a class="skip" href="#isi">Langsung ke isi</a>
<div class="topbar"><div class="wrap">
  <span><%= site.tagline %></span>
  <span class="topbar-contact"><a href="<%= waLink %>" target="_blank" rel="noopener">WhatsApp <%= site.whatsapp %></a></span>
</div></div>
<header class="header"><div class="wrap header-in">
  <a class="brand" href="/">
    <span class="brand-mark" aria-hidden="true">NU</span>
    <span><strong><%= site.site_name %></strong><small>Limpung, Batang, Jawa Tengah</small></span>
  </a>
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav">Menu</button>
  <nav id="nav" class="nav" aria-label="Menu utama">
    <ul>
      <% menu.forEach((m) => { %>
      <li class="<%= m.children.length ? 'has-sub' : '' %>">
        <% if (m.children.length) { %>
          <button type="button" class="sub-btn" aria-expanded="false"><%= m.title %></button>
          <ul class="sub"><% m.children.forEach((c) => { %><li><a href="<%= c.url || '#' %>"><%= c.title %></a></li><% }) %></ul>
        <% } else { %>
          <a href="<%= m.url || '#' %>" <%- m.url === currentPath ? 'aria-current="page"' : '' %>><%= m.title %></a>
        <% } %>
      </li>
      <% }) %>
    </ul>
    <a class="btn btn-gold nav-cta" href="<%= site.spmb_url %>" target="_blank" rel="noopener">Daftar SPMB</a>
  </nav>
</div></header>
<main id="isi">
