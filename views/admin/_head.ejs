<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#126A13">
<meta name="csrf" content="<%= csrf %>">
<title><%= title %> | Admin</title>
<link rel="icon" href="/icon.png">
<link rel="preload" href="/fonts/Satoshi-700.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/admin.css?v=2">
<script src="/js/admin.js" defer></script>
</head>
<body>
<svg class="sprite" aria-hidden="true"><defs>
  <symbol id="i-home" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></symbol>
  <symbol id="i-news" viewBox="0 0 24 24"><path d="M4 5h13v14a2 2 0 0 0 2 2H6a2 2 0 0 1-2-2z"/><path d="M17 9h3v10a2 2 0 0 1-2 2"/><path d="M8 9h5M8 13h5M8 17h3"/></symbol>
  <symbol id="i-file" viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></symbol>
  <symbol id="i-image" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="9" cy="9" r="2"/><path d="m21 15-4-4L6 21"/></symbol>
  <symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="4"/><path d="M2 21a7 7 0 0 1 14 0M16 4.5a4 4 0 0 1 0 7M19 15a6 6 0 0 1 3 6"/></symbol>
  <symbol id="i-settings" viewBox="0 0 24 24"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></symbol>
  <symbol id="i-lock" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></symbol>
  <symbol id="i-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></symbol>
  <symbol id="i-logout" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></symbol>
  <symbol id="i-refresh" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/></symbol>
  <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
  <symbol id="i-chevron" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"/></symbol>
  <symbol id="i-menu" viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.4"/><circle cx="12" cy="12" r="1.4"/><circle cx="19" cy="12" r="1.4"/></symbol>
  <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7"/><circle cx="12" cy="12" r="3"/></symbol>
  <symbol id="i-edit" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></symbol>
  <symbol id="i-trash" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></symbol>
</defs></svg>
<% if (user) {
  const links = [['/admin','Dashboard','home'],['/admin/berita','Berita','news'],['/admin/halaman','Halaman','file'],['/admin/media','Media','image'],['/admin/guru','Guru & Staff','users'],['/admin/pengaturan','Pengaturan','settings'],['/admin/password','Password','lock']];
  const isOn = (u) => (u === '/admin' ? path === '/admin/' || path === '/admin' : path.startsWith(u));
  const moreOn = ['/admin/halaman', '/admin/pengaturan', '/admin/password'].some(isOn);
%>
<div class="layout">
<aside class="side">
  <a class="logo" href="/admin"><img src="/logo-smk-putih.png" alt="SMK Ma'arif NU 01 Limpung" width="266" height="55"></a>
  <p class="side-label">Menu Admin</p>
  <nav aria-label="Menu admin"><% links.forEach(([u, l, i]) => { %><a href="<%= u %>" class="<%= isOn(u) ? 'on' : '' %>" <%- isOn(u) ? 'aria-current="page"' : '' %>><%- include('_icon', { n: i }) %><span><%= l %></span></a><% }) %></nav>
  <div class="side-foot">
    <a href="/" target="_blank" rel="noopener"><%- include('_icon', { n: 'globe' }) %><span>Lihat website</span></a>
    <form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button><%- include('_icon', { n: 'logout' }) %><span>Keluar</span></button></form>
  </div>
</aside>
<nav class="bottom" aria-label="Menu admin">
  <% links.filter(([u]) => ['/admin','/admin/berita','/admin/media','/admin/guru'].includes(u)).forEach(([u, l, i]) => { %><a href="<%= u %>" class="<%= isOn(u) ? 'on' : '' %>" <%- isOn(u) ? 'aria-current="page"' : '' %>><%- include('_icon', { n: i }) %><span><%= u === '/admin/guru' ? 'Guru' : l %></span></a><% }) %>
  <details class="more">
    <summary class="<%= moreOn ? 'on' : '' %>"><%- include('_icon', { n: 'menu' }) %><span>Lainnya</span></summary>
    <div>
      <a href="/admin/halaman"><%- include('_icon', { n: 'file' }) %>Halaman</a>
      <a href="/admin/pengaturan"><%- include('_icon', { n: 'settings' }) %>Pengaturan</a>
      <a href="/admin/password"><%- include('_icon', { n: 'lock' }) %>Password</a>
      <a href="/" target="_blank" rel="noopener"><%- include('_icon', { n: 'globe' }) %>Lihat website</a>
      <form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button><%- include('_icon', { n: 'logout' }) %>Keluar</button></form>
    </div>
  </details>
</nav>
<main class="main">
<% if (flash) { %><p class="flash" role="status"><%= flash %></p><% } %>
<% } %>
