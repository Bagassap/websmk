{
  "name": "web-smk-limpung",
  "version": "2.0.0",
  "private": true,
  "description": "Website SMK Ma'arif NU 01 Limpung (Next.js + TypeScript + PostgreSQL)",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000 -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "setup": "tsx scripts/db.ts init && tsx scripts/migrate.ts && tsx scripts/import-wxr.ts && tsx scripts/verify-import.ts",
    "db:start": "tsx scripts/db.ts start",
    "db:stop": "tsx scripts/db.ts stop",
    "migrate": "tsx scripts/migrate.ts",
    "import": "tsx scripts/import-wxr.ts",
    "verify": "tsx scripts/verify-import.ts",
    "media:check": "tsx scripts/media-check.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.1",
    "he": "^1.2.0",
    "lucide-react": "^1.78.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.14.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
