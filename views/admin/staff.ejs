<%- include('_head', { title: 'Guru & Staff' }) %>
<div class="bar"><h1>Guru &amp; Staff (<%= rows.length %>)</h1></div>
<form method="post" action="/admin/guru" class="panel staff-form" data-photo-form>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <input type="hidden" name="photo">
  <label>Nama<input name="name" required></label>
  <label>Jabatan / Mapel<input name="role"></label>
  <label>Foto<input type="file" accept="image/jpeg,image/png,image/webp,image/gif" data-photo></label>
  <button class="btn">Tambah</button>
</form>
<div class="table"><table>
  <thead><tr><th>Foto</th><th>Nama</th><th>Jabatan</th><th>Urutan</th><th></th></tr></thead>
  <tbody>
  <% rows.forEach((s) => { const f = `s${s.id}`; %>
    <tr>
      <td><% if (s.photo) { %><img class="avatar" src="<%= s.photo %>" alt=""><% } %></td>
      <td><input form="<%= f %>" name="name" value="<%= s.name %>" required aria-label="Nama"></td>
      <td><input form="<%= f %>" name="role" value="<%= s.role %>" aria-label="Jabatan"></td>
      <td><input form="<%= f %>" name="position" type="number" value="<%= s.position %>" class="small" aria-label="Urutan"></td>
      <td class="row-actions">
        <form id="<%= f %>" method="post" action="/admin/guru" data-photo-form>
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= s.id %>"><input type="hidden" name="photo">
          <label class="linkish">Foto<input type="file" hidden accept="image/jpeg,image/png,image/webp,image/gif" data-photo></label>
          <button class="linkish">Simpan</button>
        </form>
        <form method="post" action="/admin/guru/<%= s.id %>/hapus" data-confirm="Hapus data <%= s.name %>?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkish danger">Hapus</button></form>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table></div>
<%- include('_foot') %>
